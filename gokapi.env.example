# Gokapi example configuration for native (non-Docker) deployments
# ==================================================================
#
# Copy this file (e.g. to "gokapi.env"), edit as needed, then load the
# variables into your shell / service before starting the "gokapi" binary.
#
#   Linux / macOS:
#     set -a; source gokapi.env; set +a; ./gokapi
#     (or export the variables in your systemd unit's [Service] section
#      via EnvironmentFile=/path/to/gokapi.env)
#
#   Windows (PowerShell):
#     Get-Content gokapi.env | ForEach-Object {
#       if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) }
#     }
#     .\gokapi-windows-amd64.exe
#
# IMPORTANT: the database (SQLite or Redis) is NOT configured through
# environment variables. On first start, Gokapi opens a setup wizard at
# http://<host>:<port>/setup where you choose and configure the database,
# authentication and webserver settings interactively. Run the binary again
# with --reconfigure to change these settings later.
# See https://gokapi.readthedocs.io/en/latest/setup.html for details.


# ------------------------------------------------------------------
# Timezone (used for logging and scheduled cleanup)
# ------------------------------------------------------------------
TZ=UTC
#TZ=Europe/Berlin


# ------------------------------------------------------------------
# Storage backend: local disk (default) or S3 / S3-compatible
# ------------------------------------------------------------------
# Local storage needs no configuration below - files are simply stored
# under GOKAPI_DATA_DIR.
#
# To use S3 or an S3-compatible provider (e.g. Backblaze B2, MinIO), fill in
# ALL five of the following variables. Leave them unset/commented to use
# local storage instead.
#GOKAPI_AWS_BUCKET=
#GOKAPI_AWS_REGION=
#GOKAPI_AWS_KEY=
#GOKAPI_AWS_KEY_SECRET=
#GOKAPI_AWS_ENDPOINT=


# ------------------------------------------------------------------
# Directories
# ------------------------------------------------------------------
#GOKAPI_CONFIG_DIR=config
#GOKAPI_CONFIG_FILE=config.json
#GOKAPI_DATA_DIR=data


# ------------------------------------------------------------------
# Webserver
# ------------------------------------------------------------------
#GOKAPI_PORT=53842


# ------------------------------------------------------------------
# Upload / chunk configuration
# ------------------------------------------------------------------
#GOKAPI_CHUNK_SIZE_MB=45
#GOKAPI_MAX_FILESIZE=102400
#GOKAPI_MAX_MEMORY_UPLOAD=50
#GOKAPI_MAX_PARALLEL_UPLOADS=3


# ------------------------------------------------------------------
# ID lengths
# ------------------------------------------------------------------
#GOKAPI_LENGTH_ID=15
#GOKAPI_LENGTH_HOTLINK_ID=40


# ------------------------------------------------------------------
# Other
# ------------------------------------------------------------------
#GOKAPI_DISABLE_CORS_CHECK=false
#GOKAPI_LOG_STDOUT=false
#GOKAPI_ENABLE_HOTLINK_VIDEOS=false
